# Choose protocol: serial or tcp (defaults to serial when a serial port is provided)
MODBUS_PROTOCOL=serial

# Serial/RTU settings
MODBUS_SERIAL_PORT=/dev/tty.usbserial-140
MODBUS_SERIAL_BAUD_RATE=19200
MODBUS_SERIAL_DATA_BITS=8
MODBUS_SERIAL_STOP_BITS=1
MODBUS_SERIAL_PARITY=even

# TCP settings (ignored when protocol=serial)
# MODBUS_HOST=127.0.0.1
# MODBUS_PORT=502

MODBUS_UNIT_ID=1

# Optional tuning
MODBUS_CONNECT_TIMEOUT_MS=5000
MODBUS_READ_DELAY_MS=50
# MODBUS_FLOAT_MODE=BE
